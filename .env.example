# StatSkill AI Environment Configuration

# Server Settings (Server-side ONLY)
PORT=5000
NODE_ENV=development
# Server-side Secret Trainer Code (Never exposed to client)
STATSKILL_TRAINER_KEY=TRAINER-MOSPI-2025

# Gemini API Key (Server-side ONLY - Keep secret, never prefix with VITE_)
# GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration (Vite Client-side)
# If left blank, StatSkill AI gracefully boots with the built-in demo engine
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# API URL
VITE_API_BASE_URL=/api
